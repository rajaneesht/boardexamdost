{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api-proxy",
      "destination": "/api/index"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/dist/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
