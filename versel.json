{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api-proxy",
      "destination": "/api/index"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
